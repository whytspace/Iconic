{
  "name": "Iconic",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/Iconic,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/Iconic",
  "remoteUser": "vscode",
  "postCreateCommand": "cd ${containerWorkspaceFolder} && sh .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "Lua.runtime.version": "Lua 5.1",
        "Lua.workspace.checkThirdParty": false,
        "Lua.diagnostics.disable": [
          "lowercase-global"
        ],
        "Lua.format.defaultConfig": {
          "indent_style": "space",
          "indent_size": "2"
        }
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "sumneko.lua",
        "JohnnyMorganz.stylua"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:WOW_DIR:/Applications/Games/World of Warcraft},target=/wow,type=bind,readonly"
  ],
  "containerEnv": {
    "WOW_DIR": "/wow"
  }
}
