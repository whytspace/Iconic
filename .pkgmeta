package-as: Iconic

# CHANGELOG-latest.md is generated in CI with only the released version's notes.
manual-changelog:
  filename: CHANGELOG-latest.md
  markup-type: markdown

# The icon data ships as its own load-on-demand add-on folder.
move-folders:
  Iconic/Iconic_Data: Iconic_Data

ignore:
  - .cache
  - .devcontainer
  - .github
  - .gitignore
  - .luacheckrc
  - .luarc.json
  - .luacov
  - .busted
  - .styluaignore
  - AGENTS.md
  - CLAUDE.md
  - CONTRIBUTING.md
  - docs
  - README.md
  - scripts
  - spec
  - stylua.toml
  - luacov.report.out
  - Assets/*.png
  - Assets/*.svg
  # Maintainer tools, also cut from Iconic.toc and UI/Events.lua by @do-not-package@.
  - UI/Check.lua
  - UI/Demo.lua
  - UI/Screenshot.lua
  - UI/ScreenshotTour.lua
