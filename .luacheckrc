std = "lua51"
codes = true
max_line_length = false
ignore = {
  "211/ADDON_NAME",
  "212/self",
}

exclude_files = {
  ".claude/**",
  ".devcontainer/**",
  ".cache/**",
  "Iconic_Data/**",
}

files["spec"] = {
  std = "lua51+busted",
}

